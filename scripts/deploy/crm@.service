[Unit]
Description=CRM Next.js service (%i)
After=network.target
Wants=network.target

[Service]
Type=simple
User=crmapp
Group=crmapp
WorkingDirectory=/www/wwwroot/crm-system
EnvironmentFile=/etc/crm-system/%i.env
ExecStart=/usr/bin/node node_modules/next/dist/bin/next start --hostname 127.0.0.1 --port ${CRM_PORT}
ExecStartPost=/usr/bin/curl --fail --silent --show-error --retry 10 --retry-delay 2 --retry-connrefused http://127.0.0.1:${CRM_PORT}/api/health
StandardOutput=append:/www/wwwroot/crm-shared/logs/app-out.log
StandardError=append:/www/wwwroot/crm-shared/logs/app-error.log
Restart=always
RestartSec=5
KillMode=control-group
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
