# 数据库配置：按部署环境填写，禁止把稳定库连接复制给 test
DATABASE_URL="<stable 数据库连接>"
CRM_STABLE_DATABASE_URL="<stable 数据库连接>"
CRM_TEST_DATABASE_URL="<test 数据库连接>"
CRM_STABLE_PORT="3000"
CRM_TEST_PORT="3001"
CRM_STABLE_HOST="127.0.0.1"
CRM_TEST_HOST="127.0.0.1"
CRM_STABLE_UPLOAD_DIR="<stable 上传目录绝对路径>"
CRM_TEST_UPLOAD_DIR="<test 上传目录绝对路径>"
CRM_BUILD_VERSION="<发布版本>"
CRM_BUILD_COMMIT="<Git 提交 SHA>"
CRM_RELEASE_VERSION="<可选发布版本，默认读取 package.json>"

# NextAuth 配置：stable/test 使用不同域名或端口，密钥不得提交到仓库
NEXTAUTH_SECRET="<每个环境独立生成的随机密钥>"
NEXTAUTH_URL="<stable 访问地址>"
CRM_STABLE_NEXTAUTH_URL="<stable 访问地址>"
CRM_TEST_NEXTAUTH_URL="<test 访问地址>"
# 登录会话有效期，单位为秒；允许 60 秒至 30 天，默认 28800 秒（8 小时）
CRM_SESSION_MAX_AGE_SECONDS="28800"

# 加密密钥（32 字节）：每个环境独立生成
ENCRYPTION_KEY="<每个环境独立的 32 字节密钥>"

# 阿里云 OSS 配置（可选，生产环境通过服务管理器注入）
ALIYUN_OSS_REGION="<OSS 区域>"
ALIYUN_OSS_ACCESS_KEY="<OSS AccessKey>"
ALIYUN_OSS_SECRET_KEY="<OSS SecretKey>"
ALIYUN_OSS_BUCKET="<OSS Bucket>"
